# GatewayOps PostgreSQL（容器内连接参数）
GATEWAYOPS_DATABASE_HOST=gatewayops-postgres
GATEWAYOPS_DATABASE_PORT=5432
GATEWAYOPS_DATABASE_USER=gatewayops
GATEWAYOPS_DATABASE_PASSWORD=change-me
GATEWAYOPS_DATABASE_NAME=gatewayops
# 宿主机映射端口；容器内仍是 5432
GATEWAYOPS_POSTGRES_PORT=54329

# 前端对外端口（容器内 GatewayOps 仍是 8418，nginx 已下线，前端直接由 Go 嵌入 serve）
GATEWAYOPS_HTTP_PORT=8080

# 拉取的镜像 tag。生产建议锁定具体版本如 v0.1.0；想跟随主干用 edge；想跟最新发布用 latest。
GATEWAYOPS_IMAGE_TAG=latest

# Backend 运行模式 / 日志等级
GATEWAYOPS_SERVER_MODE=release
GATEWAYOPS_LOG_LEVEL=info

# 可选：容器访问 Telegram 等公网服务时使用的宿主 HTTP 代理。
# 当前主机 ShellCrash 混合代理通过 sub2api 网络网关 172.31.0.1:7890 提供服务。
GATEWAYOPS_HTTP_PROXY=http://172.31.0.1:7890
GATEWAYOPS_HTTPS_PROXY=http://172.31.0.1:7890
GATEWAYOPS_NO_PROXY=gatewayops-postgres,postgres,localhost,127.0.0.1

# 主密钥（任意长度，至少 32 字节随机串），用于 AES-GCM 加密敏感字段。
# **必填** — 修改后既有数据无法解密，请务必妥善保存。
APP_SECRET=please-change-me-to-a-long-random-secret-32bytes-min

# 鉴权开关。默认 false = 任何人访问 /api/* 都不需要登录（纯内网 / 反代后部署用）。
# 公网暴露请设 AUTH_ENABLED=true 并同时填好 ADMIN_PASSWORD。
AUTH_ENABLED=false

# 后台登录账号 / 密码。仅在 AUTH_ENABLED=true 时生效；AUTH_ENABLED=false 时可留空。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# token 签名密钥；留空时回退使用 APP_SECRET
AUTH_TOKEN_SECRET=
